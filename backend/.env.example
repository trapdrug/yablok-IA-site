# Пример настроек backend. Скопируйте в .env и вставьте свои ключи.
# Без ключей ИИ отвечает встроенными точными ответами (демо работает офлайн).

# ОСНОВНОЙ провайдер — купленный ключ DungeonAPI (OpenAI-compatible).
# Ключ вписывать только в .env локально и в переменные окружения на хостинге.
DUNGEON_BASE_URL=https://31-76-100-137.sslip.io/v1
DUNGEON_API_KEY=
DUNGEON_MODEL=gpt-6-astra

# Запасной бесплатный провайдер (не обязателен).
POLLINATIONS_API_KEY=
POLLI_MODEL=openai

# Ещё один резервный провайдер (не обязателен).
AI_FUNPAY_BASE_URL=https://www.ai-funpay.ru/v1
AI_FUNPAY_KEY=
AI_MODEL=gpt-6-astra

AI_MAX_TOKENS=350
